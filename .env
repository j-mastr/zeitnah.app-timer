# Default configuration. Override locally in .env.local (not committed) or via real
# environment variables on the server.

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=change-me

# PDO DSN of the database. SQLite works out of the box; MySQL/MariaDB and PostgreSQL
# are supported as well, e.g.
#   DATABASE_DSN="mysql:host=127.0.0.1;dbname=timing;charset=utf8mb4"
#   DATABASE_DSN="pgsql:host=127.0.0.1;dbname=timing"
DATABASE_DSN="sqlite:%kernel.project_dir%/var/data.sqlite"
DATABASE_USER=
DATABASE_PASSWORD=

# Port the WebSocket server (bin/console app:websocket-server) listens on.
WS_PORT=8080

# Public URL browsers use to reach the WebSocket server, e.g. "wss://timing.example.org/ws"
# when it is proxied through the web server. Leave empty to use ws(s)://<host>:WS_PORT.
# Set to "off" to disable WebSockets entirely (clients then sync via HTTP polling).
WS_PUBLIC_URL=

# Comma-separated list of reverse proxies to trust for X-Forwarded-* headers,
# e.g. "127.0.0.1,REMOTE_ADDR". Needed so generated URLs use the public host/scheme.
TRUSTED_PROXIES=
