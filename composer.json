{
    "name": "regatta/finish-times",
    "description": "Finish-line timing for sailing regattas with real-time sync between devices.",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-pdo": "*",
        "guzzlehttp/psr7": "^2.7",
        "ratchet/rfc6455": "^0.4",
        "react/event-loop": "^1.5",
        "react/socket": "^1.16",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php bin/console cache:clear"
        ]
    }
}
